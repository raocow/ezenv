#!/usr/bin/env bash
# rigorish — opt-in dev environment helpers.
set -eo pipefail

VERSION="0.8.0"

# Resolve this script's real location (following symlinks), then the keg/repo
# root (bin/..), so `share/rigorish` is found whether run from Homebrew or source.
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
BIN_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
SHARE="$(cd "$BIN_DIR/.." && pwd)/share/rigorish"

RC="${RIGORISH_RC:-${ZDOTDIR:-$HOME}/.zshrc}"

usage() {
  cat <<EOF
rigorish $VERSION — opt-in dev environment helpers

Usage:
  rigorish enable [feature...]      Enable feature(s) (no feature = all)
  rigorish disable <feature|all>    Disable a feature (or 'all'); a feature is required
  rigorish status                   Show which features are enabled
  rigorish doctor                   Show current environment (python/pip/venv)
  rigorish init [feature...]        Print the raw source line(s) — for eval or manual use
  rigorish sleep on|off|status      Toggle 'sudo pmset -a disablesleep' (needs sudo)
  rigorish version                  Print version
  rigorish help                     Show this help

Features:
  autovenv       Auto-activate the nearest .venv when you cd into a repo
  pyf            Make bare 'python'/'pip' resolve to python3/pip3
  envup          Add an 'envup' command: export a .env into the current shell
  all            autovenv + pyf + envup (default when no feature is given)

Per-directory git/ssh/GitHub accounts moved to gitplus — see 'git account'.
Config written by 'devrig account' is still read there, so nothing to redo.

Example:
  rigorish enable autovenv      # then: exec zsh
  rigorish sleep off            # keep the Mac awake (e.g. a long build/transfer)
  rigorish sleep on             # ...then put it back
EOF
}

# Stable share dir for lines written into the rc file: prefer the version-independent
# Homebrew opt path; fall back to the resolved location for source/dev runs.
share_dir() {
  local p
  if p="$(brew --prefix rigorish 2>/dev/null)" && [ -d "$p/share/rigorish" ]; then
    echo "$p/share/rigorish"
  else
    echo "$SHARE"
  fi
}

feature_file() {
  case "$1" in
    autovenv) echo "autovenv.zsh" ;;
    pyf)      echo "pyf.zsh" ;;
    envup)   echo "envup.zsh" ;;
    *)        return 1 ;;
  esac
}

# Echo the requested features, expanding 'all', defaulting to all when empty,
# and normalizing legacy names ('py-fallback' -> 'pyf') to their canonical form.
# 'ghswitch' used to live here too; it moved to gitplus with the account
# registry it depends on, and is sourced from there instead of being enabled
# by name.
expand_features() {
  if [ "$#" -eq 0 ]; then echo "autovenv pyf envup"; return; fi
  local f out=""
  for f in "$@"; do
    case "$f" in
      all)         out="$out autovenv pyf envup" ;;
      py-fallback) out="$out pyf" ;;   # legacy alias
      *)           out="$out $f" ;;
    esac
  done
  echo "$out"
}

# True if a feature is enabled in $RC. Recognizes the legacy feature name
# 'py-fallback' so older rigorish configurations are detected as 'pyf'.
feature_enabled() {
  [ -f "$RC" ] || return 1
  grep -qF "# rigorish:$1" "$RC" && return 0
  [ "$1" = pyf ] && grep -qF "# rigorish:py-fallback" "$RC" && return 0
  return 1
}

# --- Editor integration (autovenv only) ------------------------------------
# VSCode and its forks auto-activate the workspace's selected interpreter in
# every new terminal, workspace-wide — which fights autovenv's directory-precise
# model (it loads a venv even in dirs that have none). On `enable autovenv` we
# offer to turn that off at the user level so autovenv owns venv activation;
# `disable autovenv` offers to turn it back on. Edits are backed up (.rigorish-bak).
_EDITOR_KEY='python.terminal.activateEnvironment'

_editor_settings() {  # print settings.json path for each installed editor
  local base name
  for base in "$HOME/Library/Application Support" "$HOME/.config"; do
    [ -d "$base" ] || continue
    for name in "Cursor" "Code" "Code - Insiders" "VSCodium" "Windsurf"; do
      [ -d "$base/$name/User" ] && echo "$base/$name/User/settings.json"
    done
  done
}

_editor_set_false() {  # add "<key>": false as the first entry (JSONC-safe)
  local f="$1"
  mkdir -p "$(dirname "$f")"
  if [ ! -s "$f" ]; then
    printf '{\n    "%s": false\n}\n' "$_EDITOR_KEY" > "$f"
  else
    cp "$f" "$f.rigorish-bak"
    # Insert right after the first '{'. JSONC tolerates the trailing comma even
    # if this becomes the only key, so this is safe for compact or empty objects.
    RIGORISH_KEY="$_EDITOR_KEY" perl -0pi -e 's/\{/\{\n    "$ENV{RIGORISH_KEY}": false,/' "$f"
  fi
  echo "  ${f/#$HOME/~}: set $_EDITOR_KEY=false"
}

_editor_defer() {  # enable autovenv → offer to silence editors' auto-activation
  [ -t 0 ] || return 0
  local f todo=()
  while IFS= read -r f; do
    # A "conflict" is an editor that doesn't already set the key (respect an
    # explicit choice you've made either way).
    { [ -f "$f" ] && grep -q "$_EDITOR_KEY" "$f"; } || todo+=("$f")
  done < <(_editor_settings)
  [ "${#todo[@]}" -gt 0 ] || return 0
  printf 'VSCode and its forks, including Cursor, have their own virtual environment\n'
  printf 'automatic activation feature that may conflict with autovenv, disable it? (y/n) '
  local ans; read -r ans || return 0
  case "$ans" in
    y|Y|yes|YES) for f in "${todo[@]}"; do _editor_set_false "$f"; done ;;
    *) echo "  left editor settings unchanged." ;;
  esac
}

_editor_restore() {  # disable autovenv → offer to undo the defer
  [ -t 0 ] || return 0
  local f todo=() pat="\"$_EDITOR_KEY\"[[:space:]]*:[[:space:]]*false"
  while IFS= read -r f; do
    [ -f "$f" ] && grep -Eq "$pat" "$f" && todo+=("$f")
  done < <(_editor_settings)
  [ "${#todo[@]}" -gt 0 ] || return 0
  printf "re-enable your editor's own venv auto-activation (undo the autovenv defer)? (y/n) "
  local ans; read -r ans || return 0
  case "$ans" in
    y|Y|yes|YES)
      for f in "${todo[@]}"; do
        cp "$f" "$f.rigorish-bak"
        grep -Ev "$pat" "$f" > "$f.rigorish-tmp" || true
        mv "$f.rigorish-tmp" "$f"
        echo "  ${f/#$HOME/~}: removed $_EDITOR_KEY=false"
      done ;;
    *) return 0 ;;
  esac
}


cmd_enable() {
  local sd; sd="$(share_dir)"
  touch "$RC"
  local changed=0 f file marker feats; feats="$(expand_features "$@")"
  for f in $feats; do
    if ! file="$(feature_file "$f")"; then
      echo "rigorish: unknown feature '$f' (try: autovenv, pyf, envup, all)" >&2; continue
    fi
    if feature_enabled "$f"; then
      echo "already enabled: $f"
      continue
    fi
    marker="# rigorish:$f"
    printf 'source "%s/%s"  %s\n' "$sd" "$file" "$marker" >> "$RC"
    echo "enabled: $f"
    changed=1
  done
  # autovenv wants to be the sole venv manager — offer to stop editors from
  # auto-activating a venv in every terminal (see _editor_defer).
  case " $feats " in *" autovenv "*) _editor_defer ;; esac
  [ "$changed" = 1 ] && echo "Restart your shell to apply:  exec zsh"
  return 0
}

cmd_disable() {
  # Require an explicit feature, so a bare `rigorish disable` can't wipe everything
  # by accident. Use `rigorish disable all` to turn them all off.
  if [ "$#" -eq 0 ]; then
    echo "rigorish: pick a feature to disable: autovenv, pyf, envup (or 'all')" >&2
    return 2
  fi
  [ -f "$RC" ] || { echo "nothing to do (no $RC)"; return 0; }
  local changed=0 f tmp shim feats; feats="$(expand_features "$@")"
  for f in $feats; do
    if feature_enabled "$f"; then
      tmp="$(mktemp "${RC}.rigorish.XXXXXX")"
      # Drop the feature's line(s); for pyf also drop the legacy py-fallback
      # marker.
      # `|| true`: grep exits 1 when it filters out the only line (empty
      # output), which must not abort the removal or trip `set -e`.
      if [ "$f" = pyf ]; then
        grep -vF "# rigorish:pyf" "$RC" \
          | grep -vF "# rigorish:py-fallback" > "$tmp" || true
      else
        grep -vF "# rigorish:$f" "$RC" > "$tmp" || true
      fi
      mv "$tmp" "$RC"
      echo "disabled: $f"
      changed=1
    else
      echo "not enabled: $f"
    fi
    # Clean up pyf's shim dir so disable leaves nothing behind.
    if [ "$f" = pyf ]; then
      shim="${RIGORISH_SHIM_DIR:-$HOME/.local/share/rigorish/shims}"
      if [ -d "$shim" ]; then rm -rf "$shim"; echo "removed shims: $shim"; fi
    fi
  done
  # If we're turning autovenv off, offer to give the editor its venv activation
  # back (undo what _editor_defer did).
  case " $feats " in *" autovenv "*) _editor_restore ;; esac
  [ "$changed" = 1 ] && echo "Restart your shell to apply:  exec zsh"
  return 0
}

cmd_status() {
  echo "rc file : $RC"
  local f
  for f in autovenv pyf envup; do
    if feature_enabled "$f"; then
      echo "  $f : enabled"
    else
      echo "  $f : disabled"
    fi
  done
  # Per-directory git/ssh/GitHub accounts used to live here as `rigorish
  # account`. They moved to gitplus as `git account`, because every git-*
  # command needs to resolve the bound account before calling gh — so the
  # registry belongs with the git tooling, not a shell-helper package.
  # Existing config keeps working: `git account` reads the sentinels this
  # wrote. Mentioned here rather than dropped silently, since `rigorish status`
  # used to list accounts and someone will wonder where they went.
  if command -v git-account >/dev/null 2>&1 && [ -n "$(git-account list 2>/dev/null | head -1)" ]; then
    echo "accounts: moved to gitplus — see 'git account list'"
  fi
}

cmd_doctor() {
  echo "rigorish $VERSION"
  echo "share dir   : $(share_dir)"
  echo "python      : $(command -v python || echo '<not found>')"
  echo "python3     : $(command -v python3 || echo '<not found>')"
  echo "pip         : $(command -v pip || echo '<not found>')"
  echo "pip3        : $(command -v pip3 || echo '<not found>')"
  echo "VIRTUAL_ENV : ${VIRTUAL_ENV:-<none>}"
}

cmd_sleep() {
  case "${1:-}" in
    off)
      sudo pmset -a disablesleep 1
      echo "sleep disabled — this Mac won't sleep until 'rigorish sleep on'"
      ;;
    on)
      sudo pmset -a disablesleep 0
      echo "sleep re-enabled"
      ;;
    status)
      local v
      v="$(pmset -g | awk '/SleepDisabled/ {print $2}')"
      if [ "$v" = "1" ]; then
        echo "sleep disabled (rigorish sleep on to re-enable)"
      else
        echo "sleep enabled (normal)"
      fi
      ;;
    *)
      echo "rigorish sleep: specify 'on', 'off', or 'status'" >&2
      return 1
      ;;
  esac
}

cmd_init() {
  local sd; sd="$(share_dir)"
  local f file
  for f in $(expand_features "$@"); do
    if ! file="$(feature_file "$f")"; then
      echo "rigorish: unknown feature '$f' (try: autovenv, pyf, envup, all)" >&2; return 1
    fi
    printf 'source "%s/%s"\n' "$sd" "$file"
  done
}

case "${1:-help}" in
  enable|install)       shift; cmd_enable "$@" ;;   # 'install' kept as a back-compat alias
  disable|uninstall|remove) shift; cmd_disable "$@" ;;
  status)               cmd_status ;;
  doctor)               cmd_doctor ;;
  init)                 shift; cmd_init "$@" ;;
  # Kept as a signpost rather than removed: anyone with the old command in
  # muscle memory or a script deserves to be told where it went, not a bare
  # usage dump. Forwards the arguments so the suggestion is runnable as-is.
  account|accounts)
    shift
    echo "rigorish: accounts moved to gitplus — run: git account${*:+ $*}" >&2
    echo "  (your existing accounts and bindings still work there, unchanged)" >&2
    exit 1 ;;
  sleep)                shift; cmd_sleep "$@" ;;
  version|--version|-v) echo "rigorish $VERSION" ;;
  help|--help|-h)       usage ;;
  *)                    usage >&2; exit 1 ;;
esac
